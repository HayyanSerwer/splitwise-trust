# Developer Portal -> your app -> General Information
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Developer Portal -> your app -> Bot -> Reset Token
# The bot only needs to BE in the server; it never has to run.
DISCORD_BOT_TOKEN=

# Any random string, 32+ characters. Encrypts the session cookie.
# Generate one: openssl rand -base64 32
SESSION_SECRET=

# Neon connection string (the pooled one, ending in -pooler).
# console.neon.tech -> your project -> Connection string
DATABASE_URL=

# Only needed if the deployed URL differs from the request origin.
# OAUTH_REDIRECT_URI=https://your-app.vercel.app/api/auth/callback
